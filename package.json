{
  "name": "political-deathmatch",
  "version": "0.1.0",
  "description": "Plataforma de debate y simulación política automatizada con IA sin censura y formato televisivo",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "pauta": "tsx src/cli/generate-pauta.ts",
    "debate": "tsx src/cli/simulate-debate.ts",
    "audio": "tsx src/cli/render-audio.ts",
    "video": "tsx src/cli/render-video.ts",
    "build": "tsc",
    "test": "node --test dist/**/*.test.js",
    "assets": "tsx src/cli/generate-assets.ts"
  },
  "keywords": [
    "ai",
    "debate",
    "openspec",
    "rss",
    "sin-filtros",
    "politics"
  ],
  "author": "geoidegeoidal",
  "license": "MIT",
  "dependencies": {
    "edge-tts": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "kokoro-js": "^1.2.1",
    "sharp": "^0.35.3",
    "windows-tts": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
